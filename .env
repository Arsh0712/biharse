# ═══════════════════════════════════════════════════════════════════
#  BiharSe — complete configuration (shipped in the deploy zip)
# ═══════════════════════════════════════════════════════════════════
# ZERO-CONFIG GUARANTEE: the app runs on Vercel with NO environment
# variables at all — the SQLite seed DB is bundled and every value
# below has a safe code-level default (see src/lib/db.ts,
# src/lib/payments.ts, src/lib/email.ts). This file powers local dev,
# Docker and self-hosted runs, and can optionally be pasted into
# Vercel → Project → Settings → Environment Variables.
#
# On Vercel, .env files are NOT read at runtime — set anything you
# change there in the dashboard instead.

# ── Database ──────────────────────────────────────────────────────
# SQLite (default). Relative paths are auto-normalized at runtime
# against the project root and prisma/ (prisma CLI convention).
DATABASE_URL=file:../db/custom.db
DB_CLIENT=sqlite
# For hosted MySQL persistence instead, set DB_CLIENT=mysql and point
# DATABASE_URL at your MySQL URL (docs/vercel-deploy.md → MySQL section).

# ── Site identity ─────────────────────────────────────────────────
# Canonical base for metadata, sitemap, emails and OAuth redirects.
SITE_URL=https://biharse.org

# ── Security ──────────────────────────────────────────────────────
# HMAC secret for the sandbox payment twin + integrity checks.
# Rotate for production. Sessions are DB-backed (not secret-signed).
NEXTAUTH_SECRET=73ec8204b5ac3b434777f26fd3b58e5c636e68e82705ded122157b59d26e77c5
# Extra pepper for consent-log IP hashing (defaults are provided in code)
CONSENT_IP_PEPPER=biharse-consent-ip-pepper-v1

# ── Staff / notifications ─────────────────────────────────────────
# Sign-in comes from the shipped database (/?v=admin):
#   admin@biharse.org / u3SgHyACRk0tYkensVkw0iiu
# ADMIN_EMAIL is the recipient of order/claim notification emails.
# ADMIN_PASSWORD is used ONLY by the seed script on a fresh database.
ADMIN_EMAIL=admin@biharse.org
ADMIN_PASSWORD=u3SgHyACRk0tYkensVkw0iiu

# ── Payments (Razorpay) ───────────────────────────────────────────
# Leave empty to run the built-in sandbox payment twin (fully working
# test checkout). Fill with live keys to switch to real Razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────────
# Leave empty to keep every email in the Admin → Outbox viewer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=BiharSe
SMTP_FROM_EMAIL=no-reply@biharse.org
SMTP_REPLY_TO=

# ── Compliance ────────────────────────────────────────────────────
# Shown on invoices when set
GSTIN=

# ── Analytics (consent-gated — fire only after opt-in) ────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Google sign-in (optional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
