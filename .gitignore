# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# DEPLOY-FRIENDLY RULES — the Vercel CLI (and Git-based deploys) skip files
# matched here, so anything a deployment NEEDS must NOT be ignored:
#   db/custom.db   — the seeded database (products, admin account, content)
#   db/uploads/**  — uploaded product/brand media served by /api/media
#   .env           — portable config (Vercel ignores it at runtime, but shipping
#                    it keeps local dev + Docker + self-host zero-config)

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ship the portable .env; secrets the operator adds (e.g.
# .env.local) stay out of git. Vercel never reads .env at runtime anyway.
.env*
!/.env
!/.env.example

# vercel
.vercel

# database runtime artifacts only — the seed DB and uploads ARE shipped
# (they are the deployment's data source; see scripts/ensure-db.mjs)
db/*.db-journal
db/*.db-wal
db/*.db-shm

# generated mysql prisma client (platform-specific)
prisma/generated/


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# sandbox transfer folders — user uploads/downloads, never project code
/upload/
/download/
/shots/
/tool-results/
/agent-ctx/
