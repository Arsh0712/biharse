# BiharSe — environment template. Copy to `.env` and fill real values.
#
# ZERO-CONFIG GUARANTEE: every value below has a safe code-level default.
# The app boots and runs fully (products, admin, sandbox checkout) with NO
# environment variables at all — on Vercel the bundled SQLite seed DB is
# used automatically. Fill values only when you want real integrations.
#
# NOTE: `.env` IS shipped in the deploy zip (portable config) but Vercel
# never reads it at runtime — anything you change for a Vercel deploy goes
# in Project → Settings → Environment Variables.

# ── Database (Prisma) ──
# DB_CLIENT picks the schema used at build time (see scripts/prisma-generate.mjs):
#   sqlite (default) → prisma/schema.prisma — local dev, self-host, Vercel test deploys
#   mysql            → prisma/schema.mysql.prisma — docker compose stack or any MySQL 8 server
DB_CLIENT=sqlite
#
# SQLite path — relative paths are auto-normalized at runtime against the
# project root and prisma/ (this exact value works on every machine):
DATABASE_URL=file:../db/custom.db
# MySQL (prisma/schema.mysql.prisma) — docker compose stack or any MySQL 8 server.
# ?connection_limit=10 keeps the pool small locally; ?charset=utf8mb4 is REQUIRED for
# Hindi copy + emoji (the docker-compose mysql service also starts with utf8mb4 flags).
#   DATABASE_URL="mysql://biharse:biharse-pass@127.0.0.1:3306/biharse?connection_limit=10&charset=utf8mb4"
# Docker compose default creds: user biharse / pass biharse-pass / db biharse.
# Remember: `bun run db:generate:mysql` + `bun run db:push:mysql` before first use —
# and keep prisma/schema.prisma and prisma/schema.mysql.prisma in lockstep.
#
# Vercel test deploys: SQLite gets copied to /tmp at cold start (writable snapshot —
# data resets per instance; uploads go to /tmp too). For durable data on Vercel use a
# hosted MySQL: set DB_CLIENT=mysql + DATABASE_URL="mysql://…" in Project → Settings →
# Environment Variables, then import data with `bun run db:export` + `bun run db:import:mysql`.
# See docs/vercel-deploy.md for the full walkthrough.

# ── Site origin (used for emails, sitemap, session cookie Secure flag) ──
# On Vercel set this to your deployment URL, e.g. https://biharse.vercel.app
SITE_URL=https://biharse.org

# ── Fallback HMAC secret used to sign sandbox payment confirmations ──
# The shipped .env already carries a working value; regenerate for production:
#   openssl rand -hex 32
NEXTAUTH_SECRET=

# ── Owner / staff back office (credentials shipped in db/custom.db; sign-in at /?v=admin) ──
#   admin@biharse.org / u3SgHyACRk0tYkensVkw0iiu
ADMIN_EMAIL=admin@biharse.org
# Used ONLY by the seed script when creating a fresh database (not for sign-in).
ADMIN_PASSWORD=

# ── Razorpay payment gateway (leave KEY_ID/KEY_SECRET empty to run the sandbox payment twin) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook HMAC secret from the Razorpay Dashboard → Webhooks (empty = webhooks rejected)
RAZORPAY_WEBHOOK_SECRET=

# ── SMTP transactional email (leave HOST empty to log emails to the Admin Outbox instead of sending) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_NAME=BiharSe
SMTP_FROM_EMAIL=no-reply@biharse.org
# OptionalReply-To address for customer-facing emails
SMTP_REPLY_TO=

# ── Google OAuth customer sign-in (leave empty to disable the Google button) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Tax / legal identity printed on invoices (admin-editable alternative lives in Admin → Settings) ──
GSTIN=

# ── Consent-log IP pepper (defaults are provided in code) ──
CONSENT_IP_PEPPER=

# ── Analytics (client-side, fired only after user consent — see consent-gate.tsx) ──
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
